# Local overrides for the dev stack. The values below equal the defaults in
# docker-compose.yml, so this file changes nothing until you edit it.
#
# Variables are grouped by purpose, and two kinds sit side by side:
# - `SM_<NAME>` becomes the thundercloud setting `config["<NAME>"]`
#   (sparkmeter/config/configdict.py strips the prefix), overriding the
#   default in sparkmeter/settings.py. To find where one is used, search the
#   code for `<NAME>`, not `SM_<NAME>`: `SM_HEROKU` is read as
#   `config["HEROKU"]`. The value is parsed as JSON when it can be (`15` is a
#   number, `false` a boolean), except SERIAL, SPARKCLOUD_API_KEY,
#   SECURITY_PASSWORD_SALT and SECRET_KEY, which stay strings.
# - Unprefixed variables never reach `config`. The INIT_* ones are read
#   straight from the environment by the startup code
#   (sparkmeter/database/database.py); COMPOSE_FILE is read by Compose.

# --- Ground only (default) ---------------------------------------------------
# `docker compose up -d` runs the ground stack from docker-compose.yml alone.

# --- Ground + cloud ------------------------------------------------------------
# Uncomment to make every `docker compose` command also use
# docker-compose.cloud.yml, so you don't have to pass both `-f` flags.
# Start from a fresh ground volume (`down -v`). For one ground-only command,
# run `COMPOSE_FILE=docker-compose.yml docker compose ...`.
#COMPOSE_FILE=docker-compose.yml:docker-compose.cloud.yml

# --- Webapp settings (both modes) ----------------------------------------------
SM_CURRENCY=USD
SM_DEFAULT_PHONE_COUNTRY_CODE=1
SM_SERIAL="1234"
SM_SPARKCLOUD_API_KEY=test
# Cloud mode switch: true makes the webapp run as ThunderCloud (it sets up
# sync and seeds the admin for it). docker-compose.cloud.yml sets it on cloud.
SM_HEROKU=false
# Minutes between meter heartbeats; one of 1, 2, 3, 4, 5, 6, 7, 8, 10, 12, 15,
# 20, 30, 60. 15 is the app's default.
SM_HEARTBEAT_PERIOD=15

# --- First-boot seeding ----------------------------------------------------------
# The defaults and the admin user. Ground only: they seed ground. Ground +
# cloud: they seed cloud, and docker-compose.cloud.yml turns seeding off on
# ground whatever is set here, so ground gets these rows from cloud's initial
# load. The INIT_GROUND_* values name the site's `ground` row, which every
# webapp creates.
INIT_CREATE_DEFAULTS=true
# The admin is created only when the setting `config["INIT_ADMIN_USERNAME"]`
# is non-empty, which takes the SM_ variable; the INIT_ADMIN_* ones then give
# its username, password and email. Keep both usernames equal.
SM_INIT_ADMIN_USERNAME=admin
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=password
INIT_ADMIN_EMAIL=admin@sparkmeter.io
INIT_GROUND_NAME=Ground
INIT_GROUND_SERIAL=1234

# --- Secrets (development values; never use them outside this stack) -----------
# Flask's session signing key and Flask-Security's password-hashing salt.
SM_SECURITY_PASSWORD_SALT=dev-salt-not-secret
SM_SECRET_KEY=dev-not-secret
